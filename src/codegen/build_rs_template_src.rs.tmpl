// build.rs — generated by blast new; commit this file.
// Validates that all generated Rust files are in sync with their state sources.
// If any state file was mutated after last codegen, cargo build/check/test will
// hard-fail with an actionable message: run `blast gen all` to fix.

use std::fs;
use std::io::Read;
use std::path::Path;
use std::path::PathBuf;

const READ_BUF: usize = 65536;

const WATCHED_DIRS: &[&str] = &[
    "src/structs/generated",
    "src/models/generated",
    "src/flows/generated",
    "src/transport/http/generated",
    "src/transport/ws/generated",
];

fn main() {
    println!("cargo:rerun-if-changed=storage/blast/state/");
    println!("cargo:rerun-if-changed=src/transport/http/");
    for dir in WATCHED_DIRS {
        println!("cargo:rerun-if-changed={}", dir);
    }
    check_state_hashes();
    check_transport_handler_ctx();
}

fn check_transport_handler_ctx() {
    let manifest_dir = PathBuf::from(std::env::var("CARGO_MANIFEST_DIR").unwrap_or_else(|_| ".".to_string()));
    let transport_root = manifest_dir.join("src/transport/http");
    if !transport_root.is_dir() {
        return;
    }
    let mut hits: Vec<(PathBuf, usize, String)> = Vec::new();
    walk_transport(&transport_root, &mut hits);
    if hits.is_empty() {
        return;
    }
    let mut msg = String::from("\nbuild.rs: TRANSPORT:23 violation — http handler signatures must use `Extension<Ctx>`, not `State<Ctx>`.\n");
    msg.push_str("  per-request `Ctx` (with session loaded by `request_ctx_middleware`) is inserted as `Extension<Ctx>`.\n");
    msg.push_str("  `State<Ctx>` returns the global anonymous ctx — `ctx.require_session()` then silently fails for every protected route.\n");
    msg.push_str("  exempt: src/transport/http/middleware/ (middleware legitimately uses State<Ctx> to build the per-request Ctx).\n\n");
    for (path, line_no, snippet) in &hits {
        msg.push_str(&format!("    {}:{}  {}\n", path.display(), line_no, snippet));
    }
    panic!("{}", msg);
}

fn walk_transport(dir: &Path, hits: &mut Vec<(PathBuf, usize, String)>) {
    let entries = match fs::read_dir(dir) {
        Ok(e) => e,
        Err(_e) => return,
    };
    for entry in entries.flatten() {
        let path = entry.path();
        if path.is_dir() {
            let leaf = path.file_name().and_then(|s| s.to_str()).unwrap_or("");
            if leaf == "middleware" {
                continue;
            }
            walk_transport(&path, hits);
            continue;
        }
        if path.extension().map(|e| e != "rs").unwrap_or(true) {
            continue;
        }
        scan_transport_file(&path, hits);
    }
}

fn scan_transport_file(path: &Path, hits: &mut Vec<(PathBuf, usize, String)>) {
    let content = match fs::read_to_string(path) {
        Ok(c) => c,
        Err(_e) => return,
    };
    let mut in_block_comment = false;
    for (idx, raw) in content.lines().enumerate() {
        let trimmed = raw.trim();
        if trimmed.contains("/*") {
            in_block_comment = true;
        }
        if trimmed.contains("*/") {
            in_block_comment = false;
            continue;
        }
        if in_block_comment {
            continue;
        }
        if trimmed.starts_with("//") {
            continue;
        }
        if !trimmed.contains("State<Ctx>") && !trimmed.contains("State(ctx)") {
            continue;
        }
        hits.push((path.to_path_buf(), idx + 1, trimmed.to_string()));
    }
}

fn check_state_hashes() {
    let manifest_dir = PathBuf::from(std::env::var("CARGO_MANIFEST_DIR").unwrap_or_else(|_| ".".to_string()));
    for rel_dir in WATCHED_DIRS {
        let dir_path = manifest_dir.join(rel_dir);
        if !dir_path.is_dir() {
            continue;
        }
        check_dir(&manifest_dir, &dir_path);
    }
}

fn check_dir(root: &Path, dir: &Path) {
    let entries = match fs::read_dir(dir) {
        Ok(e) => e,
        Err(err) => panic!("build.rs: cannot read dir {}: {}", dir.display(), err),
    };
    for entry in entries.flatten() {
        let path = entry.path();
        if path.is_dir() {
            check_dir(root, &path);
            continue;
        }
        if path.extension().map(|e| e != "rs").unwrap_or(true) {
            continue;
        }
        check_file(root, &path);
    }
}

fn check_file(root: &Path, path: &Path) {
    let content = match fs::read_to_string(path) {
        Ok(c) => c,
        Err(err) => panic!("build.rs: cannot read {}: {}", path.display(), err),
    };
    let (state_rel, marker_hash) = match parse_marker(&content) {
        Some(pair) => pair,
        None => return,
    };
    let state_path = root.join(&state_rel);
    if !state_path.exists() {
        panic!(
            "\nbuild.rs: state file '{}' missing; was it deleted?\n  regenerate with: blast gen all\n  referenced by:   {}\n",
            state_rel,
            path.display()
        );
    }
    let actual_hash = compute_hash(&state_path);
    if actual_hash != marker_hash {
        panic!(
            "\nbuild.rs: state file '{}' changed since last regen — run 'blast gen all'\n  expected hash: {}\n  actual hash:   {}\n  stale file:    {}\n",
            state_rel,
            marker_hash,
            actual_hash,
            path.display()
        );
    }
}

fn parse_marker(content: &str) -> Option<(String, String)> {
    for line in content.lines().take(10) {
        let trimmed = line.trim();
        if !trimmed.starts_with("// AUTO-GENERATED from ") {
            continue;
        }
        let rest = &trimmed["// AUTO-GENERATED from ".len()..];
        let at_pos = rest.rfind(" @ ")?;
        let path_part = rest[..at_pos].trim().to_string();
        let hash_part = rest[at_pos + 3..].trim().to_string();
        if hash_part.chars().all(|c| c.is_ascii_hexdigit()) && !hash_part.is_empty() {
            return Some((path_part, hash_part));
        }
    }
    None
}

fn compute_hash(path: &Path) -> String {
    let mut file = match fs::File::open(path) {
        Ok(f) => f,
        Err(err) => panic!("build.rs: cannot open state file {}: {}", path.display(), err),
    };
    let mut hasher = blake3::Hasher::new();
    let mut buf = vec![0u8; READ_BUF];
    loop {
        let n = match file.read(&mut buf) {
            Ok(n) => n,
            Err(err) => panic!("build.rs: read error on {}: {}", path.display(), err),
        };
        if n == 0 {
            break;
        }
        hasher.update(&buf[..n]);
    }
    hasher.finalize().to_hex().to_string()
}
