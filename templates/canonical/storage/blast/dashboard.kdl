// Catablast dashboard zellij layout. Customize freely.
// Each pane is a normal `blast` subprocess.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
    }

    tab name="Dashboard" focus=true {
        pane split_direction="horizontal" {
            pane size="50%" split_direction="vertical" {
                pane size="50%" name="Menu" command="blast" {
                    args "cli"
                    focus true
                }
                pane name="Routes" command="bash" {
                    args "-c" "mkdir -p storage/logs && touch storage/logs/routes.log && tail -n200 -f storage/logs/routes.log"
                }
            }
            pane size="50%" split_direction="vertical" {
                pane size="70%" name="Server" command="bash" {
                    args "-c" "mkdir -p storage/logs && touch storage/logs/server.log && tail -n200 -f storage/logs/server.log | sed -uE 's/[0-9]{4}-[0-9]{2}-[0-9]{2}T([0-9]{2}:[0-9]{2}:[0-9]{2})\\.[0-9]+Z/\\1/'"
                }
                pane name="FE HMR" command="bash" {
                    args "-c" "mkdir -p storage/logs && touch storage/logs/fe.log && tail -n200 -f storage/logs/fe.log"
                }
            }
        }
    }

    tab name="Fuses" {
        pane name="Fuses" command="blast" {
            args "fuses" "live-table"
        }
    }

    tab name="Logs" {
        pane split_direction="horizontal" {
            pane name="Info" command="bash" {
                args "-c" "tail -n100 -f storage/logs/info.log 2>/dev/null || (touch storage/logs/info.log && tail -f storage/logs/info.log)"
            }
            pane name="Debug" command="bash" {
                args "-c" "tail -n100 -f storage/logs/debug.log 2>/dev/null || (touch storage/logs/debug.log && tail -f storage/logs/debug.log)"
            }
        }
    }
}
